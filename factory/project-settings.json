{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": ["Read(**/.env)", "Read(**/.env.*)", "Edit(**/.env)", "Edit(**/.env.*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${CYBERZAVOD_HOME:-}\" ] || node \"$CYBERZAVOD_HOME/packages/recorder/src/bin/record.ts\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${CYBERZAVOD_HOME:-}\" ] || node \"$CYBERZAVOD_HOME/packages/recorder/src/bin/record.ts\"",
            "async": true
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/turn-start.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${CYBERZAVOD_HOME:-}\" ] || node \"$CYBERZAVOD_HOME/packages/recorder/src/bin/record.ts\"",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${CYBERZAVOD_HOME:-}\" ] || node \"$CYBERZAVOD_HOME/packages/recorder/src/bin/record.ts\"",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${CYBERZAVOD_HOME:-}\" ] || node \"$CYBERZAVOD_HOME/packages/recorder/src/bin/record.ts\"",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${CYBERZAVOD_HOME:-}\" ] || node \"$CYBERZAVOD_HOME/packages/recorder/src/bin/record.ts\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${CYBERZAVOD_HOME:-}\" ] || node \"$CYBERZAVOD_HOME/packages/recorder/src/bin/record.ts\"",
            "async": true
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.sh\"",
            "timeout": 180,
            "statusMessage": "Проверяю код проекта…"
          }
        ]
      }
    ]
  }
}
