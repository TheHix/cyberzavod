{
  "name": "cyberzavod",
  "version": "0.4.0",
  "description": "Local-first, model-agnostic development harness for AI coding agents: process, checks and a journal of sessions in your repository.",
  "license": "MIT",
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "harness",
    "workflow"
  ],
  "homepage": "https://cyberzavod.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysavelii/cyberzavod.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "cyberzavod": "dist/cyberzavod.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepack": "node scripts/build.ts && node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "check": "tsc -p . && vitest run && node scripts/build.ts"
  },
  "devDependencies": {
    "@cyberzavod/adapter-claude": "workspace:*",
    "@cyberzavod/core": "workspace:*",
    "@cyberzavod/storage": "workspace:*",
    "esbuild": "0.28.2"
  }
}
