#!/usr/bin/env bash
# Ежедневный дамп базы (systemd-таймер cyberzavod-backup.timer). Хранятся 14 последних.
# Восстановление — в deploy/README.md.
set -euo pipefail

readonly APP_DIR=/srv/cyberzavod
readonly BACKUP_DIR=/srv/cyberzavod/backups
readonly KEEP=14

cd "$APP_DIR"

# До первой выкатки тег пустой и базы ещё нет — сохранять нечего. Любая другая
# проблема (база не запущена, сломан compose) должна уронить сервис, а не пропустить дамп.
tag=$(sed -n 's/^TAG=//p' .env)
if [[ -z "$tag" ]]; then
  echo "версия ещё не выкатывалась, дамп пропущен"
  exit 0
fi

target="$BACKUP_DIR/cyberzavod-$(date -u +%Y%m%dT%H%M%SZ).sql.gz"
# Дамп пишется во временный файл, чтобы оборванный не выглядел готовым.
trap 'rm -f "$target.partial"' EXIT
docker compose exec -T db pg_dump --username=cyberzavod --dbname=cyberzavod --no-owner \
  | gzip > "$target.partial"
mv "$target.partial" "$target"

# Имя дампа — время UTC в ISO-формате, поэтому глоб, отсортированный по имени, идёт от старых к новым.
dumps=("$BACKUP_DIR"/cyberzavod-*.sql.gz)
excess=$((${#dumps[@]} - KEEP))
if ((excess > 0)); then
  rm -- "${dumps[@]:0:excess}"
fi
echo "дамп: $target"
