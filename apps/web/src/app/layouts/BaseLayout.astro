---
// Fonts are served from our own server; the browser loads only the needed styles and scripts.
import "@fontsource-variable/rubik";
import "@fontsource-variable/nunito";
import "@/app/styles/global.css";
import { isUnindexedPath } from "@/shared/config/routes.ts";
import { site } from "@/shared/config/site.ts";
import {
  DEFAULT_LOCALE,
  LOCALE_TAGS,
  LOCALES,
  otherLocales,
  type Locale,
} from "@/shared/i18n/locale.ts";
import { localizedPath } from "@/shared/i18n/path.ts";
import { PREVIEW_IMAGE_SIZE, siteThemeColor } from "@/shared/lib/site-images.ts";

interface Props {
  /** Page language: set in `<html lang>` and picks the site name and description. */
  locale: Locale;
  /** Page path without the language: the page URL and its other-language versions come from it. */
  path: string;
  title?: string | undefined;
  description?: string | undefined;
  /**
   * The "not found" page: it has no address of its own (nginx serves it for any unknown one),
   * so there is no `canonical`, `hreflang` or `og:url`, and search engines do not index it.
   */
  notFound?: boolean | undefined;
}

const {
  locale,
  path,
  title,
  description = site.description[locale],
  notFound = false,
} = Astro.props;
// A gallery recording page is open only by secret link: it has no address of its own for search
// engines either.
const isIndexed = !notFound && !isUnindexedPath(path);
const siteName = site.name[locale];
const fullTitle = title ? `${title} — ${siteName}` : siteName;
const canonical = new URL(localizedPath(locale, path), Astro.site);
const alternates = LOCALES.map((alternate) => ({
  hreflang: alternate,
  href: new URL(localizedPath(alternate, path), Astro.site),
}));
const defaultAlternate = new URL(localizedPath(DEFAULT_LOCALE, path), Astro.site);
const preview = new URL(localizedPath(locale, site.images.preview), Astro.site);
// Open Graph writes the language with an underscore: ru_RU, not ru-RU.
const openGraphLocale = (of: Locale) => LOCALE_TAGS[of].replace("-", "_");
// schema.org markup: the search engine sees the site, its language and author. `<` is escaped so
// the text does not close the script tag.
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: new URL(localizedPath(locale, "/"), Astro.site).href,
  inLanguage: LOCALE_TAGS[locale],
  description: site.description[locale],
  author: { "@type": "Person", name: site.author.name, url: site.author.url },
}).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />
    <meta name="theme-color" content={siteThemeColor()} />
    <link rel="icon" type="image/svg+xml" href={localizedPath(locale, site.images.favicon)} />
    <link rel="apple-touch-icon" href={localizedPath(locale, site.images.touchIcon)} />
    {isIndexed ? (
      <>
        <link rel="canonical" href={canonical} />
        {alternates.map(({ hreflang, href }) => (
          <link rel="alternate" hreflang={hreflang} href={href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={defaultAlternate} />
      </>
    ) : (
      <meta name="robots" content="noindex" />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {isIndexed && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={openGraphLocale(locale)} />
    {otherLocales(locale).map((other) => (
      <meta property="og:locale:alternate" content={openGraphLocale(other)} />
    ))}
    <meta property="og:image" content={preview} />
    <meta property="og:image:width" content={String(PREVIEW_IMAGE_SIZE.width)} />
    <meta property="og:image:height" content={String(PREVIEW_IMAGE_SIZE.height)} />
    <meta property="og:image:alt" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={structuredData} />
  </head>
  <body>
    <slot />
  </body>
</html>
