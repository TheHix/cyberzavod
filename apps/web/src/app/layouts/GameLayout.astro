---
// Игровой экран: цех на всё окно, меню слева, панели записей, гайдов и «о заводе» поверх. Вход
// в галереи и аналитику — в панели записей: плитка в меню на 360px уже не помещается.
// Содержимое страницы — цех со своим HUD — встаёт в поле справа от меню.
import BaseLayout from "./BaseLayout.astro";
import { GuideList } from "@/widgets/guide-list";
import { RecordingList } from "@/widgets/recording-list";
import { Sidebar } from "@/widgets/sidebar";
import { galleriesUrl } from "@/entities/gallery";
import { publishedGuides } from "@/entities/guide";
import { statsUrl } from "@/entities/stats";
import { publishedRecordings } from "@/entities/recording";
import { PANELS } from "@/shared/config/panels.ts";
import { site } from "@/shared/config/site.ts";
import { LOCALE_NAMES, otherLocales, type Locale } from "@/shared/i18n/locale.ts";
import { localizedPath, pathWithoutLocale } from "@/shared/i18n/path.ts";
import { UI_TEXT } from "@/shared/i18n/ui-text.ts";
import { ButtonLink, Drawer } from "@/shared/ui";

interface Props {
  /** Язык страницы: на нём интерфейс, панели и мета-теги. */
  locale: Locale;
  title?: string;
  description?: string;
  /** Есть ли на странице журнал сборки (слот drawers) — тогда он в меню. */
  journal?: boolean;
  /** Есть ли на странице карточка проекта (слот drawers) — тогда она в меню. */
  project?: boolean;
  /**
   * Главный заголовок страницы, если его нет в содержимом: на главной HUD называет сборку
   * заголовком второго уровня, а первый — сайт. Виден только программам чтения и поисковикам.
   */
  heading?: string | undefined;
  /** Страница «не найдено»: nginx отдаёт её на любой неизвестный адрес, поисковикам она не нужна. */
  notFound?: boolean;
}

const {
  locale,
  title,
  description,
  journal = false,
  project = false,
  heading,
  notFound = false,
} = Astro.props;
// У страницы «не найдено» нет пары на другом языке по адресу: переключатель ведёт в цех.
const path = notFound ? "/" : pathWithoutLocale(Astro.url.pathname);
const closeLabel = UI_TEXT.panels.close[locale];
---

<BaseLayout locale={locale} path={path} title={title} description={description} notFound={notFound}>
  <div class="game">
    <Sidebar journal={journal} project={project} locale={locale} path={path} />
    <main class="field">
      {heading && <h1 class="visually-hidden">{heading}</h1>}
      <slot />
    </main>
  </div>

  <Drawer id={PANELS.records} title={UI_TEXT.panels.records[locale]} closeLabel={closeLabel}>
    <div class="records">
      <div class="other-builds">
        <p>{UI_TEXT.lists.otherBuilds[locale]}</p>
        <div class="links">
          <ButtonLink href={galleriesUrl(locale)}>
            {UI_TEXT.pages.galleriesTitle[locale]}
          </ButtonLink>
          <ButtonLink href={statsUrl(locale)}>{UI_TEXT.pages.statsTitle[locale]}</ButtonLink>
        </div>
      </div>
      <RecordingList recordings={publishedRecordings} locale={locale} />
    </div>
  </Drawer>
  <Drawer id={PANELS.guides} title={UI_TEXT.panels.guides[locale]} closeLabel={closeLabel}>
    <GuideList guides={publishedGuides} locale={locale} />
  </Drawer>
  <Drawer id={PANELS.about} title={UI_TEXT.panels.about[locale]} closeLabel={closeLabel}>
    <div class="about">
      {otherLocales(locale).map((other) => (
        <p>
          <a href={localizedPath(other, path)} hreflang={other} lang={other}>
            {LOCALE_NAMES[other]}
          </a>
        </p>
      ))}
      <p>{site.description[locale]}</p>
      <p>{UI_TEXT.about.how[locale]}</p>
      <p>
        <a href={site.repoUrl}>{UI_TEXT.about.code[locale]}</a>
      </p>
      <p>
        {UI_TEXT.about.madeBy[locale]}{" "}
        <a href={site.author.url} rel="author">
          {site.author.name}
        </a>
      </p>
    </div>
  </Drawer>
  <slot name="drawers" />
</BaseLayout>

<style>
  .game {
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    gap: var(--gutter);
    height: 100dvh;
    padding: var(--gutter);
  }

  .field {
    display: grid;
    min-height: 0;
  }

  .records {
    display: grid;
    gap: var(--space-l);
  }

  .other-builds {
    display: grid;
    gap: var(--space-s);
  }

  .other-builds p {
    margin: 0;
    color: var(--ink-soft);
    font-weight: 700;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .about p {
    margin: 0 0 var(--space-l);
  }

  @media (width <= 48rem) and (height > 40rem) {
    .game {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
    }
  }
</style>
