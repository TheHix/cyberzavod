---
// Список записей: заголовок, проект, день и главные счётчики каждой сборки.
import { summarize, type SessionRecord } from "@cyberzavod/core";
import { projectOf, projectUrl, publishedProjects } from "@/entities/project";
import { languageNoteOf, recordingUrl } from "@/entities/recording";
import type { Locale } from "@/shared/i18n/locale.ts";
import { UI_TEXT } from "@/shared/i18n/ui-text.ts";
import { formatCount, formatDate, formatDuration } from "@/shared/lib/format.ts";
import { ButtonLink, Card, Chip, Title } from "@/shared/ui";

interface Props {
  recordings: readonly SessionRecord[];
  /** Язык страницы: на нём подписи и форматы чисел и дат. */
  locale: Locale;
}

const { recordings, locale } = Astro.props;
---

{recordings.length === 0 ? (
  <p class="note">{UI_TEXT.lists.noRecordings[locale]}</p>
) : (
  <ul class="list">
    {recordings.map((recording) => {
      const stats = summarize(recording);
      const project = projectOf(publishedProjects, recording.projectId);
      const languageNote = languageNoteOf(recording.data.language, locale);
      return (
        <li>
          <Card>
            <div class="record">
              <Chip tone="sun">{formatDate(recording.timestamp, locale)}</Chip>
              <a href={recordingUrl(recording.id, locale)}>
                <Title as="span" lang={recording.data.language}>
                  {recording.data.title}
                </Title>
              </a>
              <ButtonLink variant="link" href={projectUrl(project.id, locale)}>
                {project.name[locale]}
              </ButtonLink>
              <p class="note">
                {formatDuration(stats.durationMs, locale)} ·{" "}
                {formatCount(stats.tokens, UI_TEXT.lists.tokens, locale)} ·{" "}
                {formatCount(stats.prompts, UI_TEXT.lists.prompts, locale)}
                {languageNote !== undefined && ` · ${languageNote}`}
              </p>
            </div>
          </Card>
        </li>
      );
    })}
  </ul>
)}

<style>
  .list {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .record {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
  }

  .note {
    margin: 0;
    color: var(--ink-soft);
    font-weight: 700;
  }
</style>
