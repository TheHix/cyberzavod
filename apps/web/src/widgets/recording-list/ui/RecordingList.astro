---
// Список записей: заголовок, проект, день и главные счётчики каждой сборки.
import { summarize, type Recording } from "@cyberzavod/core";
import { projectOf, projectUrl, publishedProjects } from "@/entities/project";
import { recordingUrl } from "@/entities/recording";
import { formatCount, formatDate, formatDuration } from "@/shared/lib/format.ts";
import { ButtonLink, Card, Chip, Title } from "@/shared/ui";

interface Props {
  recordings: readonly Recording[];
}

const { recordings } = Astro.props;
const TOKENS = { one: "токен", few: "токена", many: "токенов" };
const PROMPTS = { one: "промпт", few: "промпта", many: "промптов" };
---

{recordings.length === 0 ? (
  <p class="note">Записей пока нет.</p>
) : (
  <ul class="list">
    {recordings.map((recording) => {
      const stats = summarize(recording);
      const project = projectOf(publishedProjects, recording.project);
      return (
        <li>
          <Card>
            <div class="record">
              <Chip tone="sun">{formatDate(recording.startedAt)}</Chip>
              <a href={recordingUrl(recording.id)}>
                <Title as="span">{recording.title}</Title>
              </a>
              <ButtonLink variant="link" href={projectUrl(project.id)}>
                {project.name}
              </ButtonLink>
              <p class="note">
                {formatDuration(stats.durationMs)} · {formatCount(stats.tokens, TOKENS)} ·{" "}
                {formatCount(stats.prompts, PROMPTS)}
              </p>
            </div>
          </Card>
        </li>
      );
    })}
  </ul>
)}

<style>
  .list {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .record {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
  }

  .note {
    margin: 0;
    color: var(--ink-soft);
    font-weight: 700;
  }
</style>
