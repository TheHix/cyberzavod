---
// Сборки одного проекта по порядку задач с номерами: заголовок-ссылка на запись, день и главные
// счётчики. Тот же список — в панели записей под шапкой проекта и в панели «Проект».
import { summarize, type SessionRecord } from "@cyberzavod/core";
import { recordingUrl } from "@/entities/recording";
import type { Locale } from "@/shared/i18n/locale.ts";
import { UI_TEXT } from "@/shared/i18n/ui-text.ts";
import { formatCount, formatDate, formatDuration } from "@/shared/lib/format.ts";
import { languageNoteOf } from "@/shared/lib/language-note.ts";
import { Title } from "@/shared/ui";

interface Props {
  /** Записи сборок проекта по порядку задач (`projectSeriesOf`): номер сборки — её место здесь. */
  recordings: readonly SessionRecord[];
  /** Язык страницы: на нём подписи и форматы чисел и дат. */
  locale: Locale;
}

const { recordings, locale } = Astro.props;
---

{recordings.length === 0 ? (
  <p class="note">{UI_TEXT.lists.noRecordings[locale]}</p>
) : (
  <ol class="builds">
    {recordings.map((recording) => {
      const stats = summarize(recording);
      const languageNote = languageNoteOf(recording.data.language, locale);

      return (
        <li class="build">
          <a href={recordingUrl(recording.id, locale)}>
            <Title as="span" size="m" lang={recording.data.language}>
              {recording.data.title}
            </Title>
          </a>
          <p class="note">
            {formatDate(recording.timestamp, locale)} · {formatDuration(stats.durationMs, locale)} ·{" "}
            {formatCount(stats.tokens, UI_TEXT.lists.tokens, locale)} ·{" "}
            {formatCount(stats.prompts, UI_TEXT.lists.prompts, locale)}
            {languageNote !== undefined && ` · ${languageNote}`}
          </p>
        </li>
      );
    })}
  </ol>
)}

<style>
  .builds {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding-left: var(--space-xl);
  }

  /* Номер сборки — её место по порядку задач: плотным шрифтом, как заголовок рядом. */
  .build::marker {
    font-family: var(--font-display);
    font-weight: 800;
  }

  .note {
    margin: 0;
    color: var(--ink-soft);
    font-weight: 700;
  }
</style>
