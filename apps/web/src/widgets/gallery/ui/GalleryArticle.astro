---
// The galleries page in the field: the list and an author's gallery come from the API in the
// browser. At build time there are no address parameters, so the markup has the shared list
// loading. The examples above the list are assembled from the site recordings at build time.
import type { SessionRecord } from "@cyberzavod/core";
import type { Locale } from "@/shared/i18n/locale.ts";
import { Panel } from "@/shared/ui";
import { GalleryBoard } from "./GalleryBoard.tsx";
import GalleryExamples from "./GalleryExamples.astro";

interface Props {
  /** Site build recordings: the examples above user galleries come from them. */
  recordings: readonly SessionRecord[];
  /** Page language. */
  locale: Locale;
}

const { recordings, locale } = Astro.props;

if (Astro.site === undefined) throw new Error("в astro.config.ts не задан site");

const siteUrl = Astro.site.href;
---

<Panel scrollable>
  <div class="article">
    <GalleryBoard client:load locale={locale} siteUrl={siteUrl}>
      <GalleryExamples slot="examples" recordings={recordings} locale={locale} />
    </GalleryBoard>
  </div>
</Panel>

<style>
  .article {
    max-width: 48rem;
  }
</style>
