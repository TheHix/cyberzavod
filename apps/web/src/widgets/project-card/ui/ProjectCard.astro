---
// Project card: the description and links. The name is in the header of the panel where the card is
// shown.
import type { PublishedProject } from "@/entities/project";
import { localizeHref } from "@/shared/i18n/links.ts";
import type { Locale } from "@/shared/i18n/locale.ts";
import { UI_TEXT } from "@/shared/i18n/ui-text.ts";
import { ButtonLink } from "@/shared/ui";

interface Props {
  project: PublishedProject;
  /** Page language: the card and the interface around it are in it. */
  locale: Locale;
}

const { project, locale } = Astro.props;

if (Astro.site === undefined) throw new Error("в astro.config.ts не задан site");

const { origin } = Astro.site;
const hasLinks = project.repo !== undefined || project.website !== undefined;
---

<div class="card">
  <p class="description">{project.description[locale]}</p>
  {hasLinks && (
    <ul class="links">
      {project.repo !== undefined && (
        <li>
          <ButtonLink variant="link" href={localizeHref(project.repo, locale, origin)}>
            {UI_TEXT.project.repo[locale]}
          </ButtonLink>
        </li>
      )}
      {project.website !== undefined && (
        <li>
          <ButtonLink variant="link" href={localizeHref(project.website, locale, origin)}>
            {UI_TEXT.project.website[locale]}
          </ButtonLink>
        </li>
      )}
    </ul>
  )}
</div>

<style>
  .card {
    display: grid;
    gap: var(--space-m);
  }

  .description {
    margin: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
