---
// Project totals as counters: computed at site build time from the recordings of its builds,
// without the API.
import type { SessionRecord } from "@cyberzavod/core";
import { reworksByStageOf, totalsOf } from "@/entities/recording";
import type { Locale } from "@/shared/i18n/locale.ts";
import { StatList } from "@/shared/ui";
import { projectTotalsOf } from "../lib/totals-view.ts";

interface Props {
  /** Project build recordings in any order. */
  recordings: readonly SessionRecord[];
  /** Page language: captions, numbers and duration are in it. */
  locale: Locale;
}

const { recordings, locale } = Astro.props;
const totals = totalsOf(recordings);
const stageReworks = reworksByStageOf(recordings);
const items = projectTotalsOf(totals, stageReworks, locale);
---

<StatList items={items} />
