---
// Guide body: links to site pages in Markdown are written from the root, without the language, so
// both translations link the same way, and the links get the page language in the ready markup.
import { localizeLinks } from "@/shared/i18n/links.ts";
import type { Locale } from "@/shared/i18n/locale.ts";

interface Props {
  /** Language of the page the guide is on. */
  locale: Locale;
}

const { locale } = Astro.props;

if (Astro.site === undefined) throw new Error("в astro.config.ts не задан site");

const html = await Astro.slots.render("default");
---

<Fragment set:html={localizeLinks(html, locale, Astro.site.origin)} />
