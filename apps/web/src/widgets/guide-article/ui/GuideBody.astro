---
// Тело гайда: ссылки на страницы сайта в Markdown пишутся от корня, без языка, — так оба перевода
// ссылаются одинаково, а язык страницы ссылки получают уже в готовой разметке.
import { localizeLinks } from "@/shared/i18n/links.ts";
import type { Locale } from "@/shared/i18n/locale.ts";

interface Props {
  /** Язык страницы, на которой стоит гайд. */
  locale: Locale;
}

const { locale } = Astro.props;
if (Astro.site === undefined) throw new Error("в astro.config.ts не задан site");
const html = await Astro.slots.render("default");
---

<Fragment set:html={localizeLinks(html, locale, Astro.site.origin)} />
