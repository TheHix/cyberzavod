---
// Personal cabinet in the field: who is signed in and their gallery come from the API in the
// browser. At build time nobody is signed in and nothing is known, so the markup has the title,
// a loading state and the CLI hint.
import type { Locale } from "@/shared/i18n/locale.ts";
import { Panel } from "@/shared/ui";
import { CabinetBoard } from "./CabinetBoard.tsx";

interface Props {
  /** Page language. */
  locale: Locale;
}

const { locale } = Astro.props;

if (Astro.site === undefined) throw new Error("в astro.config.ts не задан site");

const siteUrl = Astro.site.href;
---

<Panel scrollable>
  <div class="article">
    <CabinetBoard client:load locale={locale} siteUrl={siteUrl} />
  </div>
</Panel>

<style>
  .article {
    max-width: 48rem;
  }
</style>
