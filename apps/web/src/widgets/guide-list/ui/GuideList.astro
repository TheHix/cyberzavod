---
// Список гайдов: название-ссылка и описание каждого.
import { guideUrl, type PublishedGuide } from "@/entities/guide";
import type { Locale } from "@/shared/i18n/locale.ts";
import { UI_TEXT } from "@/shared/i18n/ui-text.ts";
import { Card, Title } from "@/shared/ui";

interface Props {
  guides: readonly PublishedGuide[];
  /** Язык страницы: на нём список и сами гайды. */
  locale: Locale;
}

const { guides, locale } = Astro.props;
---

{guides.length === 0 ? (
  <p class="note">{UI_TEXT.lists.noGuides[locale]}</p>
) : (
  <ul class="list">
    {guides.map(({ id, translations }) => (
      <li>
        <Card>
          <div class="guide">
            <a href={guideUrl(id, locale)}>
              <Title as="span">{translations[locale].title}</Title>
            </a>
            <p class="note">{translations[locale].description}</p>
          </div>
        </Card>
      </li>
    ))}
  </ul>
)}

<style>
  .list {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
  }

  .note {
    margin: 0;
    color: var(--ink-soft);
    font-weight: 700;
  }
</style>
