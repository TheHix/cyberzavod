---
// Список гайдов: название-ссылка и описание каждого.
import { guideUrl, type PublishedGuide } from "@/entities/guide";
import { Card, Title } from "@/shared/ui";

interface Props {
  guides: readonly PublishedGuide[];
}

const { guides } = Astro.props;
---

{guides.length === 0 ? (
  <p class="note">Гайдов пока нет.</p>
) : (
  <ul class="list">
    {guides.map(({ meta }) => (
      <li>
        <Card>
          <div class="guide">
            <a href={guideUrl(meta.id)}>
              <Title as="span">{meta.title}</Title>
            </a>
            <p class="note">{meta.description}</p>
          </div>
        </Card>
      </li>
    ))}
  </ul>
)}

<style>
  .list {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
  }

  .note {
    margin: 0;
    color: var(--ink-soft);
    font-weight: 700;
  }
</style>
