---
// Журнал сборки: промпты человека и реплики цеха одним списком по времени. Промпт — как
// сообщение модели, которая его получила: главное указание видно сразу, уточнения раскрываются
// без JS через <details>. Реплика раскрыта целиком: строка из цеха и полный текст абзацами.
// Каждая запись — остров client:visible со статичным телом в слоте: пока журнал закрыт, его
// не видно и JS не грузится. Подсветка записи, до которой дошёл цех, и кнопка «показать в цехе»
// появляются только с JS, когда запись на экране; без него остаётся эта же разметка.
import type { MessageEvent, PromptEvent, Recording } from "@cyberzavod/core";
import { recipientOf } from "@/entities/prompt";
import { messageAnchor, paragraphsOf, routeOf } from "@/entities/message";
import type { Speech } from "@/features/journal-sync";
import { formatClock } from "@/shared/lib/format.ts";
import { BulletList, buttonClass, Title } from "@/shared/ui";
import { JournalEntry } from "./JournalEntry.tsx";

interface Props {
  /** Полная запись: в журнале, в отличие от цеха, есть полные тексты реплик. */
  recording: Recording;
}

type Entry =
  | { kind: "prompt"; prompt: PromptEvent; speech: Extract<Speech, { kind: "prompt" }> }
  | { kind: "message"; message: MessageEvent; speech: Extract<Speech, { kind: "message" }> };

const { recording } = Astro.props;

// Номера промптов и реплик — те же, что у пузырей в цехе: по ним цех и журнал находят друг
// друга, а по номеру реплики «подробнее» находит запись.
const entries: Entry[] = [];
let promptIndex = 0;
let messageIndex = 0;
for (const event of recording.events) {
  if (event.type === "prompt") {
    entries.push({
      kind: "prompt",
      prompt: event,
      speech: { kind: "prompt", index: promptIndex++ },
    });
  }
  if (event.type === "message") {
    entries.push({
      kind: "message",
      message: event,
      speech: { kind: "message", index: messageIndex++ },
    });
  }
}
---

{entries.length === 0 ? (
  <p class="empty">В этой сборке нет промптов и реплик.</p>
) : (
  <ol class="timeline">
    {entries.map((entry) =>
      entry.kind === "prompt" ? (
        <li>
          <JournalEntry
            client:visible
            speech={entry.speech}
            clock={formatClock(entry.prompt.t)}
            route={`человек → ${recipientOf(entry.prompt)}`}
          >
            {entry.prompt.requirements.length === 0 ? (
              <Title>{entry.prompt.goal}</Title>
            ) : (
              <details class="details">
                <summary>
                  <Title as="span">{entry.prompt.goal}</Title>
                  <span class={`more ${buttonClass({ variant: "link" })}`}>подробнее</span>
                </summary>
                <BulletList items={entry.prompt.requirements} />
              </details>
            )}
          </JournalEntry>
        </li>
      ) : (
        <li id={messageAnchor(entry.speech.index)}>
          <JournalEntry
            client:visible
            speech={entry.speech}
            clock={formatClock(entry.message.t)}
            route={routeOf(entry.message)}
          >
            <Title>{entry.message.line}</Title>
            <div class="text">
              {paragraphsOf(entry.message.text).map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </JournalEntry>
        </li>
      ),
    )}
  </ol>
)}

<style>
  .timeline {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Реплику, к которой пришли по «подробнее», не прячет под край панели. */
  .timeline > li {
    scroll-margin: var(--space-l);
  }

  .text {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-xs);
  }

  .text p {
    margin: 0;
    white-space: pre-line;
  }

  .details summary {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
    margin-bottom: var(--space-xs);
    cursor: pointer;
    list-style: none;
  }

  .details summary::-webkit-details-marker {
    display: none;
  }

  /* Раскрытый промпт сворачивается кликом по нему же — подсказка больше не нужна. */
  .details[open] .more {
    display: none;
  }

  .empty {
    margin: 0;
    color: var(--ink-soft);
  }
</style>
