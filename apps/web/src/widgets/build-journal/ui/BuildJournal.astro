---
// Журнал сборки на странице записи из журнала проекта: промпты и вмешательства человека и
// реплики цеха одним списком по времени. Каждая запись — остров client:visible со статичным
// телом в слоте: пока журнал закрыт, его не видно и JS не грузится. Подсветка записи, до
// которой дошёл цех, и кнопка «показать в цехе» появляются только с JS, когда запись на экране;
// без него остаётся эта же разметка. Острова создаёт только Astro, поэтому список собран здесь,
// а тело записи, шапка и стили — общие с `JournalTimeline`, журналом записи из API.
import type { SessionRecord } from "@cyberzavod/core";
import type { Locale } from "@/shared/i18n/locale.ts";
import { UI_TEXT } from "@/shared/i18n/ui-text.ts";
import { languageNoteOf } from "@/shared/lib/language-note.ts";
import { headerOf, timelineOf } from "../lib/timeline.ts";
import { EntryBody } from "./EntryBody.tsx";
import { JournalEntry } from "./JournalEntry.tsx";
import styles from "./Timeline.module.css";

interface Props {
  /** Полная запись: в журнале, в отличие от цеха, есть полные тексты реплик. */
  recording: SessionRecord;
  /** Язык страницы: на нём метки и подписи журнала. */
  locale: Locale;
}

const { recording, locale } = Astro.props;
const entries = timelineOf(recording.data.events);
const { language } = recording.data;
const languageNote = languageNoteOf(language, locale);
---

{languageNote !== undefined && <p class={styles.language}>{languageNote}</p>}

{entries.length === 0 ? (
  <p class={styles.empty}>{UI_TEXT.journal.empty[locale]}</p>
) : (
  <ol class={styles.timeline}>
    {entries.map((entry) => {
      const { anchor, clock, route } = headerOf(entry, locale);

      return (
        <li id={anchor}>
          <JournalEntry
            client:visible
            recordingId={recording.id}
            speech={entry.speech}
            locale={locale}
            clock={clock}
            route={route}
          >
            <EntryBody entry={entry} language={language} locale={locale} />
          </JournalEntry>
        </li>
      );
    })}
  </ol>
)}
