---
// Промпты человека по ходу сборки — как сообщения модели, которая их получила.
// Главное указание видно сразу, уточнения раскрываются: без JS, через <details>.
import type { PromptEvent, Recording } from "@cyberzavod/core";
import { recipientOf } from "@/entities/prompt";
import { formatClock } from "@/shared/lib/format.ts";
import { BulletList, buttonClass, Card, Chip, Title } from "@/shared/ui";

interface Props {
  recording: Recording;
}

const { recording } = Astro.props;
const prompts = recording.events.filter((event): event is PromptEvent => event.type === "prompt");
---

{prompts.length === 0 ? (
  <p class="empty">В этой сборке человек не писал промптов.</p>
) : (
  <ol class="timeline">
    {prompts.map((prompt) => (
      <li>
        <Card>
          <p class="route">
            <Chip>{formatClock(prompt.t)}</Chip>
            <Chip tone="sky">человек → {recipientOf(prompt)}</Chip>
          </p>
          {prompt.requirements.length === 0 ? (
            <Title>{prompt.goal}</Title>
          ) : (
            <details class="details">
              <summary>
                <Title as="span">{prompt.goal}</Title>
                <span class={`more ${buttonClass({ variant: "link" })}`}>подробнее</span>
              </summary>
              <BulletList items={prompt.requirements} />
            </details>
          )}
        </Card>
      </li>
    ))}
  </ol>
)}

<style>
  .timeline {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .route {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0 0 var(--space-xs);
  }

  .details summary {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
    margin-bottom: var(--space-xs);
    cursor: pointer;
    list-style: none;
  }

  .details summary::-webkit-details-marker {
    display: none;
  }

  /* Раскрытый промпт сворачивается кликом по нему же — подсказка больше не нужна. */
  .details[open] .more {
    display: none;
  }

  .empty {
    margin: 0;
    color: var(--ink-soft);
  }
</style>
