---
// Build series journal on the home page and the project page: shows the build that is on the floor
// now. Full recordings load as files in the browser, so the whole journal is one island; while the
// panel is closed it is not visible, and idle time is enough for the island.
import type { Locale } from "@/shared/i18n/locale.ts";
import { SeriesJournal } from "./SeriesJournal.tsx";

interface Props {
  /** Build ids of the series in the order the floor plays them. */
  recordingIds: readonly string[];
  /** Page language: journal labels, captions and messages are in it. */
  locale: Locale;
}

const { recordingIds, locale } = Astro.props;
---

<SeriesJournal client:idle recordingIds={recordingIds} locale={locale} />
