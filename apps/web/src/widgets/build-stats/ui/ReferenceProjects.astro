---
// Сравнение эталонных проектов: считается при сборке сайта из записей их сборок, без API, —
// поэтому это статичная разметка, а не часть острова с аналитикой открытых галерей.
import type { SessionRecord } from "@cyberzavod/core";
import { projectOf, publishedProjects } from "@/entities/project";
import { projectSeriesOf, totalsOf } from "@/entities/recording";
import type { Locale } from "@/shared/i18n/locale.ts";
import { UI_TEXT } from "@/shared/i18n/ui-text.ts";
import { BarList, Title } from "@/shared/ui";
import { referenceChartsOf, type ReferenceProject } from "../lib/reference-view.ts";

interface Props {
  /** Записи сборок сайта в любом порядке. */
  recordings: readonly SessionRecord[];
  /** Язык страницы: на нём заголовки, названия проектов и числа. */
  locale: Locale;
}

const { recordings, locale } = Astro.props;
const projects: ReferenceProject[] = projectSeriesOf(recordings).map((series) => ({
  name: projectOf(publishedProjects, series.projectId).name[locale],
  totals: totalsOf(series.recordings),
}));
const charts = referenceChartsOf(projects, locale);
---

{projects.length > 0 && (
  <section class="section">
    <Title as="h2">{UI_TEXT.statsSections.referenceHeading[locale]}</Title>
    <p class="intro">{UI_TEXT.statsSections.referenceIntro[locale]}</p>
    {charts.map((chart) => (
      <section class="chart">
        <Title as="h3" size="m">
          {chart.heading}
        </Title>
        <BarList items={chart.bars} />
      </section>
    ))}
  </section>
)}

<style>
  .section {
    display: grid;
    gap: var(--space-l);
  }

  .chart {
    display: grid;
    gap: var(--space-s);
  }

  .intro {
    margin: 0;
    color: var(--ink-soft);
    font-weight: 700;
  }
</style>
