---
// Промпты человека по ходу сборки — как сообщения модели, которая их получила.
// Главное указание видно сразу, уточнения раскрываются: без JS, через <details>.
import type { PromptEvent, Recording } from "@cyberzavod/core";
import { formatClock, formatModel } from "@/shared/lib/format.ts";

interface Props {
  recording: Recording;
}

const { recording } = Astro.props;
const prompts = recording.events.filter((event): event is PromptEvent => event.type === "prompt");
const recipient = (prompt: PromptEvent) =>
  prompt.model === undefined ? "агент" : formatModel(prompt.model);
---

{prompts.length === 0 ? (
  <p class="empty">В этой сборке человек не писал промптов.</p>
) : (
  <ol class="timeline">
    {prompts.map((prompt) => (
      <li class="message">
        <p class="route">
          <span class="at">{formatClock(prompt.t)}</span>
          <span>человек → {recipient(prompt)}</span>
        </p>
        {prompt.requirements.length === 0 ? (
          <p class="goal">{prompt.goal}</p>
        ) : (
          <details>
            <summary class="goal">{prompt.goal}</summary>
            <ul class="requirements">
              {prompt.requirements.map((requirement) => (
                <li>{requirement}</li>
              ))}
            </ul>
          </details>
        )}
      </li>
    ))}
  </ol>
)}

<style>
  .timeline {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .message {
    padding: 0.875rem 1.25rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .route {
    display: flex;
    gap: 0.75rem;
    margin: 0 0 0.375rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .goal {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  summary.goal {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }

  summary.goal::-webkit-details-marker {
    display: none;
  }

  summary.goal::after {
    flex-shrink: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 400;
    content: "▸ подробнее";
  }

  details[open] > summary.goal::after {
    content: "▾ свернуть";
  }

  /* На узком экране подпись отнимала бы ширину у текста промпта — остаётся стрелка. */
  @media (max-width: 30rem) {
    summary.goal::after {
      content: "▸";
    }

    details[open] > summary.goal::after {
      content: "▾";
    }
  }

  .requirements {
    display: grid;
    gap: 0.375rem;
    margin: 0.75rem 0 0;
    padding: 0.75rem 0 0 1.25rem;
    border-top: 1px dashed var(--line);
  }

  .requirements li::marker {
    color: var(--accent);
  }

  .empty {
    margin: 0;
    color: var(--muted);
  }
</style>
