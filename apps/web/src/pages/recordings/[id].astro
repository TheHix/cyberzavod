---
import type { GetStaticPaths } from "astro";
import type { Recording } from "@cyberzavod/core";
import BaseLayout from "@/app/layouts/BaseLayout.astro";
import { BuildStats } from "@/widgets/build-stats";
import { PromptTimeline } from "@/widgets/prompt-timeline";
import { publishedRecordings } from "@/entities/recording";
import { formatDate } from "@/shared/lib/format.ts";

export const getStaticPaths = (() =>
  publishedRecordings.map((recording) => ({
    params: { id: recording.id },
    props: { recording },
  }))) satisfies GetStaticPaths;

interface Props {
  recording: Recording;
}

const { recording } = Astro.props;
const description = `Как ИИ-агенты собирали «${recording.title}»: промпты человека, время и токены.`;
---

<BaseLayout title={recording.title} description={description}>
  <main class="page">
    <a href="/">← Все записи</a>

    <header>
      <h1>{recording.title}</h1>
      <p class="muted">{formatDate(recording.startedAt)}</p>
    </header>

    <BuildStats recording={recording} />

    <section aria-labelledby="prompts-title">
      <h2 id="prompts-title">Промпты</h2>
      <PromptTimeline recording={recording} />
    </section>
  </main>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 2rem;
    max-width: 60rem;
    margin: 0 auto;
    padding: 3rem 1rem;
  }

  h1 {
    margin: 0;
  }

  .muted {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }
</style>
