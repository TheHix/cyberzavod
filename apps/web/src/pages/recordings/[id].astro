---
import type { GetStaticPaths } from "astro";
import { briefOf, type Recording } from "@cyberzavod/core";
import GameLayout from "@/app/layouts/GameLayout.astro";
import { Factory } from "@/widgets/factory";
import { BuildJournal } from "@/widgets/build-journal";
import { publishedRecordings } from "@/entities/recording";
import { PANELS } from "@/shared/config/panels.ts";
import { Drawer } from "@/shared/ui";

export const getStaticPaths = (() =>
  publishedRecordings.map((recording) => ({
    params: { id: recording.id },
    props: { recording },
  }))) satisfies GetStaticPaths;

interface Props {
  recording: Recording;
}

const { recording } = Astro.props;
const description = `Как ИИ-агенты собирали «${recording.title}»: промпты человека, реплики мастера и станций, время и токены.`;
---

<GameLayout title={recording.title} description={description} journal>
  <Factory client:load recording={briefOf(recording)} />
  <Drawer slot="drawers" id={PANELS.journal} title="Журнал сборки">
    <BuildJournal recording={recording} />
  </Drawer>
</GameLayout>
