---
import type { GetStaticPaths } from "astro";
import type { Recording } from "@cyberzavod/core";
import GameLayout from "@/app/layouts/GameLayout.astro";
import { Factory } from "@/widgets/factory";
import { PromptTimeline } from "@/widgets/prompt-timeline";
import { publishedRecordings } from "@/entities/recording";
import { PANELS } from "@/shared/config/panels.ts";
import { Drawer } from "@/shared/ui";

export const getStaticPaths = (() =>
  publishedRecordings.map((recording) => ({
    params: { id: recording.id },
    props: { recording },
  }))) satisfies GetStaticPaths;

interface Props {
  recording: Recording;
}

const { recording } = Astro.props;
const description = `Как ИИ-агенты собирали «${recording.title}»: промпты человека, время и токены.`;
---

<GameLayout title={recording.title} description={description} promptLog>
  <Factory client:load recording={recording} />
  <Drawer slot="drawers" id={PANELS.promptLog} title="Журнал промптов">
    <PromptTimeline recording={recording} />
  </Drawer>
</GameLayout>
