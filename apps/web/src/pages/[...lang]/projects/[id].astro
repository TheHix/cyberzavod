---
import type { GetStaticPaths } from "astro";
import type { SessionRecord } from "@cyberzavod/core";
import GameLayout from "@/app/layouts/GameLayout.astro";
import { SeriesFactory, seriesBuildsOf } from "@/widgets/factory";
import { SeriesBuildJournal } from "@/widgets/build-journal";
import { ProjectCard } from "@/widgets/project-card";
import { ProjectTotals } from "@/widgets/project-totals";
import { ProjectBuilds } from "@/widgets/recording-list";
import { projectLinkOf, publishedProjects, type PublishedProject } from "@/entities/project";
import { publishedRecordings, recordingsOfProject } from "@/entities/recording";
import { PANELS } from "@/shared/config/panels.ts";
import { LOCALES, type Locale } from "@/shared/i18n/locale.ts";
import { localeParam } from "@/shared/i18n/path.ts";
import { UI_TEXT } from "@/shared/i18n/ui-text.ts";
import { Drawer, Panel, Title } from "@/shared/ui";

export const getStaticPaths = (() =>
  LOCALES.flatMap((locale) =>
    publishedProjects.map((project) => ({
      params: { lang: localeParam(locale), id: project.id },
      props: {
        locale,
        project,
        recordings: recordingsOfProject(publishedRecordings, project.id),
      },
    })),
  )) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
  project: PublishedProject;
  /** Project builds in task order. */
  recordings: readonly SessionRecord[];
}

const { locale, project, recordings } = Astro.props;
const closeLabel = UI_TEXT.panels.close[locale];
// This project's series on a loop: from the first build, in task order.
const seriesBuilds = seriesBuildsOf(recordings, projectLinkOf(project, locale), locale);
const recordingIds = seriesBuilds.map((build) => build.recording.id);
const hasBuilds = seriesBuilds.length > 0;
---

<GameLayout
  locale={locale}
  title={UI_TEXT.pages.projectTitle[locale](project.name[locale])}
  description={project.description[locale]}
  heading={project.name[locale]}
  journal={hasBuilds}
  project
>
  {hasBuilds ? (
    <SeriesFactory client:load locale={locale} builds={seriesBuilds} titleLevel="h2" />
  ) : (
    <Panel label={UI_TEXT.pages.floor[locale]}>
      <p>{UI_TEXT.pages.noBuilds[locale]}</p>
    </Panel>
  )}
  {hasBuilds && (
    <Drawer
      slot="drawers"
      id={PANELS.journal}
      title={UI_TEXT.panels.journal[locale]}
      closeLabel={closeLabel}
    >
      <SeriesBuildJournal recordingIds={recordingIds} locale={locale} />
    </Drawer>
  )}
  <Drawer slot="drawers" id={PANELS.project} title={project.name[locale]} closeLabel={closeLabel}>
    <div class="project">
      <ProjectCard project={project} locale={locale} />
      {hasBuilds && (
        <section class="section">
          <Title as="h3">{UI_TEXT.projectPanel.totalsHeading[locale]}</Title>
          <ProjectTotals recordings={recordings} locale={locale} />
        </section>
      )}
      <section class="section">
        <Title as="h3">{UI_TEXT.projectPanel.buildsHeading[locale]}</Title>
        <ProjectBuilds recordings={recordings} locale={locale} />
      </section>
    </div>
  </Drawer>
</GameLayout>

<style>
  .project {
    display: grid;
    gap: var(--space-xl);
  }

  .section {
    display: grid;
    gap: var(--space-m);
  }
</style>
