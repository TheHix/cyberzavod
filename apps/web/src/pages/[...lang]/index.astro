---
import type { GetStaticPaths } from "astro";
import GameLayout from "@/app/layouts/GameLayout.astro";
import { SeriesFactory, seriesBuildsOf } from "@/widgets/factory";
import { SeriesBuildJournal } from "@/widgets/build-journal";
import { HomeIntro } from "@/widgets/home-intro";
import { projectLinkOf, projectOf, publishedProjects } from "@/entities/project";
import { projectSeriesOf, publishedRecordings } from "@/entities/recording";
import { PANELS } from "@/shared/config/panels.ts";
import { site } from "@/shared/config/site.ts";
import { LOCALES, type Locale } from "@/shared/i18n/locale.ts";
import { localeParam } from "@/shared/i18n/path.ts";
import { UI_TEXT } from "@/shared/i18n/ui-text.ts";
import { Drawer, Panel } from "@/shared/ui";

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({
    params: { lang: localeParam(locale) },
    props: { locale },
  }))) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// Series on a loop: a project's builds in task order, then the next project's builds.
const seriesBuilds = projectSeriesOf(publishedRecordings).flatMap(({ projectId, recordings }) => {
  const project = projectOf(publishedProjects, projectId);

  return seriesBuildsOf(recordings, projectLinkOf(project, locale), locale);
});
const recordingIds = seriesBuilds.map((build) => build.recording.id);
const hasBuilds = seriesBuilds.length > 0;
---

<GameLayout
  locale={locale}
  journal={hasBuilds}
  heading={UI_TEXT.pages.homeHeading[locale](site.name[locale])}
>
  {hasBuilds ? (
    <SeriesFactory client:load locale={locale} builds={seriesBuilds} titleLevel="h2">
      <HomeIntro locale={locale} />
    </SeriesFactory>
  ) : (
    <Panel label={UI_TEXT.pages.floor[locale]}>
      <p>{UI_TEXT.lists.noRecordings[locale]}</p>
    </Panel>
  )}
  {hasBuilds && (
    <Drawer
      slot="drawers"
      id={PANELS.journal}
      title={UI_TEXT.panels.journal[locale]}
      closeLabel={UI_TEXT.panels.close[locale]}
    >
      <SeriesBuildJournal recordingIds={recordingIds} locale={locale} />
    </Drawer>
  )}
</GameLayout>
