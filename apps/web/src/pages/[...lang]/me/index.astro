---
import type { GetStaticPaths } from "astro";
import GameLayout from "@/app/layouts/GameLayout.astro";
import { Cabinet } from "@/widgets/cabinet";
import { LOCALES, type Locale } from "@/shared/i18n/locale.ts";
import { localeParam } from "@/shared/i18n/path.ts";
import { UI_TEXT } from "@/shared/i18n/ui-text.ts";

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({
    params: { lang: localeParam(locale) },
    props: { locale },
  }))) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<GameLayout
  locale={locale}
  title={UI_TEXT.pages.cabinetTitle[locale]}
  description={UI_TEXT.pages.cabinetDescription[locale]}
>
  <Cabinet locale={locale} />
</GameLayout>
