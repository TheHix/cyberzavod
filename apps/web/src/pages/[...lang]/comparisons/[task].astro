---
import type { GetStaticPaths } from "astro";
import GameLayout from "@/app/layouts/GameLayout.astro";
import { BuildComparison } from "@/widgets/build-comparison";
import { publishedRecordings, taskComparisonsOf, type TaskComparison } from "@/entities/recording";
import { LOCALES, type Locale } from "@/shared/i18n/locale.ts";
import { localeParam } from "@/shared/i18n/path.ts";
import { UI_TEXT } from "@/shared/i18n/ui-text.ts";

export const getStaticPaths = (() =>
  LOCALES.flatMap((locale) =>
    taskComparisonsOf(publishedRecordings).map((comparison) => ({
      params: { lang: localeParam(locale), task: comparison.task },
      props: { locale, comparison },
    })),
  )) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
  comparison: TaskComparison;
}

const { locale, comparison } = Astro.props;
const [firstRun] = comparison.recordings;
const taskTitle = firstRun?.data.title ?? comparison.task;
---

<GameLayout
  locale={locale}
  title={UI_TEXT.pages.comparisonTitle[locale](taskTitle)}
  description={UI_TEXT.pages.comparisonDescription[locale](taskTitle)}
>
  <BuildComparison comparison={comparison} locale={locale} />
</GameLayout>
