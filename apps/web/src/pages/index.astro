---
import GameLayout from "@/app/layouts/GameLayout.astro";
import { Factory } from "@/widgets/factory";
import { PromptTimeline } from "@/widgets/prompt-timeline";
import { publishedRecordings } from "@/entities/recording";
import { PANELS } from "@/shared/config/panels.ts";
import { site } from "@/shared/config/site.ts";
import { Drawer, Panel } from "@/shared/ui";

const [latest] = publishedRecordings;
---

<GameLayout promptLog={latest !== undefined} heading={`${site.name} — цех ИИ-агентов`}>
  {latest ? (
    <Factory client:load recording={latest} titleLevel="h2" />
  ) : (
    <Panel label="Цех">
      <p>Записей пока нет.</p>
    </Panel>
  )}
  {latest && (
    <Drawer slot="drawers" id={PANELS.promptLog} title="Журнал промптов">
      <PromptTimeline recording={latest} />
    </Drawer>
  )}
</GameLayout>
