---
import BaseLayout from "@/app/layouts/BaseLayout.astro";
import { BuildStats } from "@/widgets/build-stats";
import { RecordingList } from "@/widgets/recording-list";
import { publishedRecordings } from "@/entities/recording";
import { site } from "@/shared/config/site.ts";

const [latest] = publishedRecordings;
---

<BaseLayout>
  <main class="page">
    <header>
      <h1>{site.name}</h1>
      <p class="lead">{site.description}</p>
    </header>

    <section aria-labelledby="factory-title" class="factory">
      <h2 id="factory-title">Цех</h2>
      <p class="muted">Здесь будет изометрический цех, который проигрывает запись сборки.</p>
    </section>

    {latest && (
      <section aria-labelledby="latest-title">
        <h2 id="latest-title">Последняя сборка: {latest.title}</h2>
        <BuildStats recording={latest} />
      </section>
    )}

    <section aria-labelledby="recordings-title">
      <h2 id="recordings-title">Записи сборок</h2>
      <RecordingList recordings={publishedRecordings} />
    </section>

    <footer>
      <a href={site.repoUrl}>Код на GitHub</a>
    </footer>
  </main>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 2.5rem;
    max-width: 60rem;
    margin: 0 auto;
    padding: 3rem 1rem;
  }

  .lead {
    max-width: 40rem;
    color: var(--muted);
    font-size: 1.125rem;
  }

  .factory {
    display: grid;
    place-content: center;
    min-height: 20rem;
    border: 1px dashed var(--line);
    text-align: center;
  }

  .muted {
    color: var(--muted);
  }
</style>
