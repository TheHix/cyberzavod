---
import type { GetStaticPaths } from "astro";
import GameLayout from "@/app/layouts/GameLayout.astro";
import { publishedGuides, type PublishedGuide } from "@/entities/guide";
import { GuideArticle } from "@/widgets/guide-article";

export const getStaticPaths = (() =>
  publishedGuides.map((guide) => ({
    params: { id: guide.meta.id },
    props: { guide },
  }))) satisfies GetStaticPaths;

interface Props {
  guide: PublishedGuide;
}

const { guide } = Astro.props;
---

<GameLayout title={guide.meta.title} description={guide.meta.description}>
  <GuideArticle guide={guide} />
</GameLayout>
